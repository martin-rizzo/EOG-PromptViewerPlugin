/build

# Ignore all hidden files/folders in the root directory,
# except for the specified files
/.*
!.gitignore


# Ignore any file or folder ending with a tilde (~)
*~
*~.*
*~/


# Generated Files #
/config.h
/libsdprompt-viewer.so
/org.gnome.eog.plugins.sdprompt-viewer.gschema.xml
/sdprompt-viewer-plugin.o
/sdprompt-viewer-preferences.o
/sdprompt-viewer-resources.c
/sdprompt-viewer-resources.o
/sdprompt-viewer.plugin


# Kate Swap Files #
.*.kate-swp
.swp.*
