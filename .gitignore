# Ignore all hidden files and directories in the root,
# except for the explicitly listed ones (e.g: .gitignore)
/.*
!.gitignore
!.gitmodules
!.github/


# Ignore files and directories ending with a tilde (~)
*~
*~.*
*~/


# Ignore generated files and directories
/bin
/build
/org.gnome.eog.plugins.sdprompt-viewer.gschema.xml


# Ignore all Kate swap files
# (in case you still use Kate)
.*.kate-swp
.swp.*
